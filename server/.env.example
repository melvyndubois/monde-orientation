# Copier en .env (non versionné) et remplir, ou exporter ces variables avant de lancer.
# Clé API Anthropic — reste UNIQUEMENT côté serveur, jamais dans le navigateur.
ANTHROPIC_API_KEY=sk-ant-api03-...

# Port d'écoute du proxy (défaut : 8787)
PORT=8787

# Origines autorisées (CORS), séparées par des virgules.
# En dev local on peut mettre * ; en production, lister les domaines réels.
# Exemple : ALLOWED_ORIGINS=https://monde.app,https://www.monde.app
ALLOWED_ORIGINS=*
